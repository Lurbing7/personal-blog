---
// 代码雨背景：Canvas 数字雨，浅色主题适配（薄荷绿 + 靛蓝）
// - 全页极淡背景，pointer-events: none，不影响交互
// - 尊重 prefers-reduced-motion：直接不渲染动画
// - 页面隐藏时暂停，DPR 封顶，控制性能
---

<div class="code-rain-wrap" aria-hidden="true">
  <canvas id="code-rain"></canvas>
</div>

<style>
  .code-rain-wrap {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.45;
  }
  #code-rain {
    width: 100%;
    height: 100%;
  }
  @media (prefers-reduced-motion: reduce) {
    .code-rain-wrap {
      display: none;
    }
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>("#code-rain");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (canvas && !reduceMotion) {
    const cv = canvas;
    const ctx = cv.getContext("2d");
    if (ctx) {
      const c2 = ctx;
      const glyphs =
        "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789<>/{}[]();:+=-_*&^%$#@!~`".split("");
      let w = 0;
      let h = 0;
      let cols = 0;
      let drops: number[] = [];
      let fontSize = 16;
      let raf = 0;
      let running = true;

      function resize() {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = window.innerWidth;
        h = window.innerHeight;
        cv.width = w * dpr;
        cv.height = h * dpr;
        cv.style.width = w + "px";
        cv.style.height = h + "px";
        c2.setTransform(dpr, 0, 0, dpr, 0, 0);
        // 字号随屏幕适度放大，保持疏密度
        fontSize = Math.max(13, Math.round(Math.min(w, h) / 95));
        cols = Math.ceil(w / fontSize);
        drops = [];
        for (let i = 0; i < cols; i++) drops.push(Math.random() * -80);
        c2.fillStyle = "rgba(255,255,255,1)";
        c2.fillRect(0, 0, w, h);
      }

      function step() {
        if (!running) return;
        // 向白色淡出形成尾迹（画布本体为白色，与页面底色一致）
        c2.fillStyle = "rgba(255,255,255,0.045)";
        c2.fillRect(0, 0, w, h);
        c2.font = fontSize + 'px "JetBrains Mono", ui-monospace, monospace';
        for (let i = 0; i < cols; i++) {
          const ch = glyphs[(Math.random() * glyphs.length) | 0];
          const x = i * fontSize;
          const y = drops[i] * fontSize;
          if (y > 0 && y < h + fontSize) {
            // 尾迹字符：薄荷绿（低透明度）
            c2.fillStyle = "rgba(45,160,102,0.28)";
            c2.fillText(ch, x, y - fontSize);
            // 头部字符：偶发靛蓝，其余薄荷绿
            c2.fillStyle =
              Math.random() < 0.16 ? "rgba(52,56,144,0.9)" : "rgba(45,160,102,0.85)";
            c2.fillText(ch, x, y);
          }
          if (y > h + 40 && Math.random() > 0.976) {
            drops[i] = Math.random() * -40;
          } else {
            drops[i]++;
          }
        }
        raf = requestAnimationFrame(step);
      }

      function onVisibility() {
        running = !document.hidden;
        if (running) {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(step);
        }
      }

      window.addEventListener("resize", resize);
      document.addEventListener("visibilitychange", onVisibility);
      resize();
      raf = requestAnimationFrame(step);
    }
  }
</script>
