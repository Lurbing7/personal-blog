---
import Layout from "@/layouts/Layout.astro";
import { u } from "@/lib/posts";
---

<Layout title="404 · 云忆" description="页面不存在">
  <main class="max-w-3xl mx-auto px-6 pt-40 md:pt-52 pb-24 text-center">
    <p class="text-[var(--sec)] text-7xl md:text-8xl font-semibold tracking-tight">404</p>
    <h1 class="mt-6 text-2xl md:text-3xl font-semibold text-[var(--white)]">页面不存在</h1>
    <p class="mt-4 text-[var(--white-icon)]">你访问的页面可能已被移动或删除。</p>
    <a
      href={u("/")}
      class="inline-block mt-10 px-6 py-3 rounded-xl bg-[var(--sec)] text-[#101010] font-semibold hover:opacity-90 transition-opacity"
    >
      回到首页
    </a>
  </main>
</Layout>
